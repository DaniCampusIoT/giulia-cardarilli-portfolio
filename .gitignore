cat > .gitignore <<'EOF'
# Sistema operativo
.DS_Store
Thumbs.db

# Visual Studio Code
.vscode/

# Dependencias futuras
node_modules/

# Variables privadas
.env
.env.*
!.env.example

# Archivos temporales y de compilación
dist/
build/
coverage/

# Registros
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
EOF